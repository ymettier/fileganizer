---
# All YAML configuration keys can be overridden via FILEGANIZER_* environment
# variables. The prefix FILEGANIZER_ is stripped, then the name is lowercased
# and underscores are replaced with dots to match the YAML key path.
# Examples: FILEGANIZER_LOGGING_LEVEL=debug, FILEGANIZER_TEXTEXTRACTOR_TYPE=pdf

# Logging configuration (optional). Defaults to INFO level on stderr.
# Valid filename values: "stdout", "stderr", or a file path (enables rotation).
# logging:
#   level: INFO
#   filename: stdout
#   maxSize: 5
#   maxBackups: 10
#   maxAge: 14
#   compress: true
#   json: false

# textExtractor maps MIME types to extraction methods.
# The file type is detected automatically using MIME (magic bytes).
# type: "builtin" (internal extractor) or "command" (runs an external command).
# command: (required when type is "command") the command to run.
#          The special string "FILENAME" is replaced with the real file name.
# Available builtins: "application/pdf", "text/plain"
textExtractor:
  "application/pdf":
    type: builtin
  "text/plain":
    type: command
    command: ["cat", "FILENAME"]
# Examples :
#   Using builtin extractors for PDF and text files:
#     textExtractor:
#       "application/pdf":
#         type: builtin
#       "text/plain":
#         type: builtin
#   Using pdftotext for PDFs:
#     textExtractor:
#       "application/pdf":
#         type: command
#         command: ["pdftotext", "-nopgbrk", "-enc", "UTF-8", "FILENAME", "-"]
#   Using cat for text files:
#     textExtractor:
#       "text/plain":
#         type: command
#         command: ["cat", "FILENAME"]

# These variables will be available as go-template vars for output.
# Example : {{ .Env.DEST }}
# env:
#   - DEST

# This template will be concatenated to output template.
# It allows to pre-define templates.
commonTemplate: ""

# These variables are use to
# 1. generate grokPatterns. Example :
#      MONTHSFRENCHLOWERCASE: "(janvier|février|mars|avril|mai|juin|juillet|aout|septembre|octobre|novembre|décembre"
# 2. in a go-template function "MonthIndex" to convert the given string into a string with the number of the month.
#      Example : "{{ MonthIndex .Grok.month }}" will convert to "02" if .Grok.month is "février".
months:
  MONTHSFRENCHLOWERCASE: ["janvier", "février", "mars", "avril", "mai", "juin", "juillet", "aout", "septembre", "octobre", "novembre", "décembre"]

grokPatterns:
  NUMBER: '[0-9]+'
  YEAR: "(?:\\d\\d){1,2}"
  MONTHNUM2: "0[1-9]|1[0-2]"
  MONTHDAY: "(?:0[1-9])|(?:[12][0-9])|(?:3[01])|[1-9]"

fileDescriptions:
  myMobile:
    patterns:
      - "(?s)Forfait mobile.*ligne : %{NUMBER:numLigne}"
      - "Identifiant : %{NUMBER:identifiant}"
# Output is go-template.
# It may use these fonctions :
# - ToUpper (see strings.ToUpper)
# - ToLower (see strings.ToLower)
# - MonthIndex (see above)
# - NowYYYY (returns now with layout YYYY)
# - NowYYYYMMDD (returns now with layout YYYYMMDD)
# - NowYYYYMMDD_HHMMSS (returns now with layout YYYYMMDD_HHMMSS)
    output : "mv {{ .Filename }} {{ .Env.DEST }}/invoice_{{ .Grok.identifiant }}_{{ .Grok.numLigne }}_{{ .Grok.year }}-{{ MonthIndex .Grok.month }}-{{ .Grok.day }}.pdf"
